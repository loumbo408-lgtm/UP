# Development placeholders — overridden by /run/base44/app.env (platform secrets).
# These let the app boot before real credentials are provided.

# Supabase service-role key (needed for admin API routes only).
# Replace with your real key from the Supabase dashboard → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_dev_placeholder
SUPABASE_SECRET_KEY=sb_secret_dev_placeholder

# Mobile Money gateway (Airtel Money / Moov Money) — sandbox/demo placeholder.
PSP_API_KEY=psp_sandbox_demo_key

# Admin security key — default matches the code fallback.
UP_ADMIN_SECURITY_KEY=UP2026
