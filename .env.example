# ---------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# Cle service role : serveur uniquement. Elle contourne la RLS et ne doit
# jamais etre prefixee NEXT_PUBLIC_ ni committee.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Passerelle Mobile Money
# ---------------------------------------------------------------------
# Secret partage servant a verifier la signature HMAC des callbacks.
MOBILE_MONEY_WEBHOOK_SECRET=changez-moi

# Laisser vide pour rester en mode simulation : le parcours de paiement se
# deroule entierement, sans appeler d'operateur reel.
AIRTEL_MONEY_BASE_URL=
AIRTEL_MONEY_API_KEY=
MOOV_MONEY_BASE_URL=
MOOV_MONEY_API_KEY=
